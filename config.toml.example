# Example configuration for hearthd
#
# Copy this file to /etc/hearthd/config.toml and customize as needed

[logging]
# Log level: trace, debug, info, warn, error
# Use "debug" or "trace" to see the full config printed at startup
level = "info"

[engine]
# What to do when two integrations declare a node under the same entity id
# (for example both offering "sensor.porch").
#
#   "suffix" (default) admits the second one under a numbered name
#            ("sensor.porch_2"), logged at warn level.
#   "reject" refuses it instead, so the clashing node is dropped entirely.
#
# Which node keeps the bare name follows registration order under either
# setting, and for discovered devices that is whatever arrives first — so a
# clash is worth fixing at the source rather than living with. The default
# keeps the losing device reachable in the meantime.
#
# duplicate_entity_ids = "suffix"

[locations]
# The default location to use
default = "home"

# Define your locations with coordinates
[locations.home]
latitude = 59.9139
longitude = 10.7522
elevation_m = 10  # optional, elevation in meters
timezone = "Europe/Oslo"  # optional, can be inferred from lat/long

[locations.work]
latitude = 59.9110
longitude = 10.7579
# elevation_m and timezone are optional and can be omitted

[integrations]

# EcoFlow, over EcoFlow's consumer cloud API. Currently supports the Wave 3
# portable air conditioner.
#
# The consumer API cannot enumerate devices, so there is no discovery: every
# device is declared here by the serial number printed on the unit and shown in
# the EcoFlow app.
#
# [integrations.ecoflow]
# email and password are secrets. The account password grants full control of
# every device on the account, so keep these two in a separate, tightly
# permissioned file and list it alongside this one:
#
#     hearthd --config /etc/hearthd/config.toml --config /etc/hearthd/secrets.toml
#
# email = "user@example.com"
# password = "..."
#
# api_host defaults to api.ecoflow.com and rarely needs setting: EcoFlow routes
# by account rather than by region. Do not point it at api-e.ecoflow.com or
# api-a.ecoflow.com, which speak the unrelated public developer API.
# api_host = "api.ecoflow.com"

# One section per device. The key names the entity, so this becomes
# "climate.bedroom".
# [integrations.ecoflow.devices.bedroom]
# serial = "HW51ZAS4..."
# name = "Bedroom air conditioner"  # optional, defaults to the key

# Snapcast, over a Snapserver's control protocol. Groups and clients are
# discovered from the server, so only the server itself is configured here.
#
# Each group becomes a "media_player." entity and each client a "speaker."
# entity, named after the group or client name set in Snapcast and falling
# back to the device id where that name is empty.
#
# [integrations.snapcast]
# host = "snapserver.example.com"
#
# port is the JSON-RPC control port, not the 1704 stream port.
# port = 1705
#
# How long to wait before reconnecting after the control connection drops.
# The integration resynchronises its whole view on every reconnect, so
# nothing is lost by waiting.
# reconnect_interval_ms = 5000
